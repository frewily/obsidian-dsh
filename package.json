{
  "name": "obsidian-dsh",
  "version": "0.1.0",
  "description": "DeepSeek Harness for Obsidian：Claudian 式原生聊天面板，对接完整 DSH 后端",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
